---
import { absolute, site } from "../lib/config";
import { posts } from "../lib/content";
import { getProjects } from "../lib/projects";
import { renderMarkdown } from "../lib/markdown";
import { scriptJson } from "../lib/html";
import { featuredPosts } from "../site.config";
interface Props { kind?: "home" | "post" | "page"; title?: string; description?: string; path?: string; section?: string; jsonLd?: unknown; titleFont?: string; archiveStart?: number; }
const {kind='home',title=site.title,description=site.description,path, jsonLd, archiveStart}=Astro.props;
const canonical=path ? absolute(path) : kind === 'home' ? site.url : null;
const desktopPosts = await Promise.all(posts.map(async post => ({
  title: post.title, description: post.description, date: post.createdDate,
  tags: post.tags.map(tag => tag.name), url: post.path, issueNumber: post.issueNumber,
  featured: featuredPosts.includes(post.issueNumber), markdown: post.markdown,
  html: await renderMarkdown(post.markdown),
})));
const desktopProjects = (await getProjects()).filter(p => p.featured).map(p => ({
  title:p.title, summary:p.summary, url:p.path, image:p.image,
}));
const blogData = { posts:desktopPosts, projects:desktopProjects, total:posts.length, featured:featuredPosts };
const styles = ['style','macos','desktop-apps','reader','obsidian-workspace','native-experiences','site-shell'];
const scripts = ['app','reader','track','desktop-apps','obsidian-workspace','native-experiences','site-shell','window-manager','navigation'];
---
<!doctype html>
<html lang={site.language}>
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title === site.title ? title : `${title} · ${site.title}`}</title><meta name="description" content={description}>
{canonical && <link rel="canonical" href={canonical}>}{!canonical && <meta name="robots" content="noindex">}<link rel="icon" href={site.profile.avatar}>
<link rel="alternate" type="application/atom+xml" title={site.title} href="/atom.xml">
<meta property="og:type" content={kind === "post" ? "article" : "website"}><meta property="og:title" content={title}>
<meta property="og:description" content={description}><meta property="og:url" content={canonical}>
<meta property="og:image" content={site.seo.socialImage}>
<meta property="og:site_name" content={site.title}>
<meta name="twitter:card" content="summary"><meta name="twitter:title" content={title}><meta name="twitter:description" content={description}><meta name="twitter:image" content={absolute(site.profile.avatar)}>
{site.seo.googleSearchConsole && <meta name="google-site-verification" content={site.seo.googleSearchConsole}>}
{styles.map(name => <link rel="stylesheet" href={`/desktop/${name}.css`} />)}
<link rel="stylesheet" href="/assets/css/syntax.css">
<script is:inline set:html={`window.BLOG=${scriptJson(blogData)};window.DESKTOP_ROUTE=${scriptJson({kind,title,path:path || "/",archiveStart})};if(/^\\/blog\\/(?:page\\/\\d+\\/)?$/.test(location.pathname))document.documentElement.classList.add("finder-route");`}></script>
{scripts.map(name => <script is:inline src={`/desktop/${name}.js`} defer></script>)}
<script is:inline type="application/ld+json" set:html={scriptJson(jsonLd || {"@context":"https://schema.org","@type":"WebSite",name:site.title,url:site.url,description:site.description})}></script>
</head>
<body data-variant="B" data-route-kind={kind}>

<div id="world"></div>
{kind !== 'home' && <section id="route-window" class="route-window" aria-label={title}><header class="route-toolbar"><div class="route-lights"><a class="route-close" href="/" aria-label="关闭窗口并返回桌面"></a><span aria-hidden="true"></span><span aria-hidden="true"></span></div><a href="/" aria-label="返回桌面">‹ 桌面</a><strong>{title}</strong><nav aria-label="站点导航"><a href="/blog/">文章</a><a href="/projects/">项目</a><a href="/tags/">标签</a><a href="/about/">关于</a></nav></header><main id="main-content" class="route-content"><slot /></main></section>}
<dialog id="reader" aria-labelledby="reader-title"><div class="reader-bar"><button data-close class="reader-back" aria-label="返回文章列表">‹ 返回</button><span id="reader-filename">文稿</span><div class="reader-tools"><button id="outline-toggle" aria-controls="reader-outline" aria-expanded="true">☷ 目录</button><button id="reader-discuss">评论</button><select class="theme-picker" aria-label="外观主题"><option value="system">跟随系统</option><option value="light">Light</option><option value="dark">Dark</option></select><a id="original" target="_blank" rel="noopener">原文 ↗</a></div></div><div class="reading-layout"><aside id="reader-outline"><p>大纲</p><nav id="outline-links" aria-label="文章目录"></nav></aside><div class="reader-scroll" tabindex="0" role="region" aria-label="文章正文"><div class="reading-paper"><header><p id="reader-meta" class="eyebrow"></p><h1 id="reader-title"></h1></header><article id="reader-body"></article><section id="reader-comments" tabindex="-1" aria-labelledby="discussion-title"><div class="discussion-heading"><h2 id="discussion-title">评论</h2><a id="discussion-link" target="_blank" rel="noopener">在 GitHub 讨论 ↗</a></div><p id="comments-status" role="status"></p><div id="discussion-embed"></div><button id="load-comments">加载评论</button></section></div></div></div><footer class="reader-status"><span>Markdown · 阅读模式</span><span id="reading-stats"></span></footer></dialog>
<dialog id="about" aria-labelledby="about-title"><button class="about-close" data-close aria-label="关闭关于窗口">×</button><img src="/desktop/assets/avatar.png" alt="Geo Qiao"><p class="eyebrow">THE HUMAN BEHIND THE DESKTOP</p><h2 id="about-title">你好，我是 Geo。</h2><p>金融行业的贷后策略分析师。工作之外，喜欢折腾 Python、TypeScript 和 AI 编程工作流。</p><p>这里存放我的文章、做出来的小工具，以及一路上的思考。</p><a href="/about/">更多关于我 ↗</a></dialog>

<div class="sr-only" id="announce" aria-live="polite"></div>

<a class="desktop-access" href="/blog/">文章归档 ↗</a>
<noscript><style>.route-window{position:relative!important;inset:auto!important;margin:20px!important;height:auto!important;max-height:none!important}.route-content{overflow:visible!important}.desktop-fallback[hidden]{display:none}.desktop-fallback{display:block;padding:30px;background:white;color:#222}#world,.desktop-access{display:none}</style><main class="desktop-fallback" hidden={kind !== "home"}><h1>{site.title}</h1><p>{site.description}</p><nav><a href="/about/">关于</a> · <a href="/projects/">项目</a></nav><h2>文章</h2><ul>{posts.map(post=><li><a href={post.path}>{post.title}</a></li>)}</ul></main></noscript>
</body></html>
