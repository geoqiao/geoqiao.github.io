---
import HeaderControls from "../components/HeaderControls.astro";
import Search from "../components/Search.astro";
import { absolute, site } from "../lib/config";
import { scriptJson } from "../lib/html";
import { showPoweredBy } from "../site.config";

interface Props {
  kind?: "home" | "post" | "page";
  title?: string;
  description?: string;
  /** The page's own path; a page without one (404) is not indexed. */
  path?: string;
  /** The navigation item this page belongs to. */
  section?: string;
  jsonLd?: unknown;
}

const { kind = "page", title = site.title, description = site.description, path, section, jsonLd } = Astro.props;
const canonical = path ? absolute(path) : null;
const { socialImage, socialImageAlt, googleSearchConsole } = site.seo;
---
<!DOCTYPE html>
<html lang={site.language}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}{title !== site.title && ` · ${site.title}`}</title>
  <meta name="description" content={description}>
  {canonical ? <link rel="canonical" href={canonical}> : <meta name="robots" content="noindex">}
  <meta property="og:site_name" content={site.title}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  {canonical && <meta property="og:url" content={canonical}>}
  <meta property="og:type" content={kind === "post" ? "article" : "website"}>
  {socialImage ? (
    <Fragment>
      <meta property="og:image" content={socialImage}>
      {socialImageAlt && <meta property="og:image:alt" content={socialImageAlt}>}
      <meta name="twitter:card" content="summary_large_image">
      <meta name="twitter:image" content={socialImage}>
      {socialImageAlt && <meta name="twitter:image:alt" content={socialImageAlt}>}
    </Fragment>
  ) : (
    <meta name="twitter:card" content="summary">
  )}
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  {canonical && <meta name="twitter:url" content={canonical}>}
  {googleSearchConsole && <meta name="google-site-verification" content={googleSearchConsole}>}
  <link rel="icon" href={site.profile.avatar || "/assets/images/favicon.png"}>
  <link rel="alternate" type="application/atom+xml" title={site.title} href="/atom.xml">
  <script is:inline src="/assets/js/appearance.js"></script>
  <link rel="stylesheet" href="/assets/css/style.css">
  <link rel="stylesheet" href="/assets/css/syntax.css">
  <link rel="stylesheet" href="/assets/css/search.css">
  <link rel="stylesheet" href="/assets/css/geo.css">
  {kind === "home" && (
    <Fragment>
      <link rel="preload" href="/assets/fonts/shantell-sans-latin-400.woff2" as="font" type="font/woff2" crossorigin>
      <link rel="stylesheet" href="/assets/css/home.css">
      <script is:inline src="/assets/js/home.js" defer></script>
    </Fragment>
  )}
  <script is:inline src="/assets/js/site.js" defer></script>
  <script is:inline src="/assets/js/search.js" data-search-index="/search.json" defer></script>
  {jsonLd && <script is:inline type="application/ld+json" set:html={scriptJson(jsonLd)}></script>}
</head>
<body id="top" class={kind === "home" ? "home" : undefined}>
  <a class="skip-link" href="#main-content" lang="en">Skip to main content</a>
  {kind === "home" ? (
    <header class="home-tools" lang="en">
      <HeaderControls />
    </header>
  ) : (
    <header class="site-header" lang="en">
      <div class="header-row">
        {site.navigation.length > 0 && (
          <div class="navigation-area">
            <button class="navigation-toggle" type="button" aria-expanded="false" aria-controls="site-navigation">Menu <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" aria-hidden="true"><path d="m3 4.5 3 3 3-3"/></svg></button>
            <nav id="site-navigation" aria-label="Main navigation">
              {site.navigation.map((item) => (
                <Fragment><a href={item.url} aria-current={item.url === section ? "page" : undefined}>{item.name}</a>{" "}</Fragment>
              ))}
            </nav>
          </div>
        )}
        <div class="header-controls"><HeaderControls /></div>
      </div>
    </header>
  )}
  <Search />
  <div class="site-surface">
    <main id="main-content" tabindex="-1"><slot /></main>
    <footer class="site-footer" lang="en">
      <div><strong>{site.author}</strong><span>Thanks for reading.</span></div>
      <nav aria-label="Footer links">
        {site.profile.links.map((link) => <a href={link.url}>{link.name} ↗</a>)}
        <a href="/atom.xml">RSS ↗</a>
        {showPoweredBy && <a href="https://github.com/geoqiao/escaping">escaping</a>}
      </nav>
    </footer>
  </div>
</body>
</html>
