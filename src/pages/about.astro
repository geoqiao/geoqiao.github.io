---
import Comments from "../components/Comments.astro";
import Mermaid from "../components/Mermaid.astro";
import ProjectEntry from "../components/ProjectEntry.astro";
import Base from "../layouts/Base.astro";
import { absolute, site } from "../lib/config";
import { about } from "../lib/content";
import { renderMarkdown } from "../lib/markdown";
import { getProjects } from "../lib/projects";

// config.yaml names an About Issue; escaping refuses to export without it.
if (!about) throw new Error("The export has no About page.");
const body = await renderMarkdown(about.markdown);
const featuredProjects = (await getProjects()).filter((project) => project.featured).slice(0, 4);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.author,
  url: absolute("/about/"),
  description: about.description,
};
---
<Base title={about.title} description={about.description} path="/about/" section="/about/" jsonLd={jsonLd}>
<article class="about-page">
  <header class="about-header"><p class="eyebrow muted">About</p><h1>{about.title}</h1></header>
  <div class="post-content about-story" set:html={body} />
  {featuredProjects.length > 0 && (
    <section class="about-works" aria-labelledby="projects-title">
      <div class="section-heading"><h2 id="projects-title">Also building</h2><a class="more-projects" href="/projects/">All projects <span aria-hidden="true">↗</span></a></div>
      <div class="about-projects">{featuredProjects.map((project) => <ProjectEntry project={project} compact />)}</div>
    </section>
  )}
  <div class="article-end"><a href="/">Back to Home</a><a href="#top">Back to top ↑</a></div>
  {site.comments.enabled && <Comments issueNumber={about.issueNumber} />}
</article>
<Mermaid />
</Base>
