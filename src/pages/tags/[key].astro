---
import EntryList from "../../components/EntryList.astro";
import Base from "../../layouts/Base.astro";
import { tags } from "../../lib/site";

export function getStaticPaths() {
  return tags.map((tag) => ({ params: { key: tag.key }, props: { tag } }));
}

const { tag } = Astro.props;
---
<Base title={tag.name} path={tag.path} section="/tags/">
<div class="page-heading"><a class="breadcrumb" href="/tags/">← Tags</a><h1 class="topic-heading">{tag.name}</h1><p>{tag.posts.length} related {tag.posts.length === 1 ? "article" : "articles"}</p></div>
<div class="tag-entries"><EntryList posts={tag.posts} /></div>
</Base>
