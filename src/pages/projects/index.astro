---
import ProjectEntry from "../../components/ProjectEntry.astro";
import Base from "../../layouts/Base.astro";
import { getProjects } from "../../lib/projects";

const projects = await getProjects();
---
<Base title="Projects" path="/projects/" section="/projects/">
<div class="page-heading"><p class="eyebrow">{projects.length} public projects</p><h1>Projects<span class="heading-dot" aria-hidden="true">.</span></h1><p>Tools for writing, building, and working with AI.</p></div>
<div class="project-list">{projects.map((project) => <ProjectEntry project={project} />)}{projects.length === 0 && <p class="empty-state">No public projects yet.</p>}</div>
</Base>
