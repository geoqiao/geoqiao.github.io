---
import Comments from "../../components/Comments.astro";
import TagLinks from "../../components/TagLinks.astro";
import Base from "../../layouts/Base.astro";
import { absolute, site } from "../../lib/config";
import { posts } from "../../lib/content";
import { renderMarkdown } from "../../lib/markdown";
import { titleFont } from "../../lib/title-font";

export function getStaticPaths() {
  return posts.map((post, index) => ({
    params: { slug: post.slug },
    props: { post, newer: posts[index - 1], older: posts[index + 1] },
  }));
}

const { post, newer, older } = Astro.props;
const body = await renderMarkdown(post.markdown);
const font = await titleFont(post);
if (/<h1[\s>]/.test(body)) {
  // The page's <h1> is the Issue title; see "本站博客发布规范" in README.md.
  const message = `Issue #${post.issueNumber} (${post.slug}): the body has a level-1 heading; start the body at ##`;
  // Astro prints the page's path without a line break; an annotation must start its own line.
  console.warn(process.env.GITHUB_ACTIONS ? `\n::warning title=Heading level::${message}` : message);
}
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.title,
  description: post.description,
  url: absolute(post.path),
  datePublished: post.publishedAt.replace(/Z$/, "+00:00"),
  dateModified: post.updatedAt.replace(/Z$/, "+00:00"),
  author: { "@type": "Person", name: site.author },
};
---
<Base kind="post" title={post.title} description={post.description} path={post.path} section="/blog/" jsonLd={jsonLd} titleFont={font?.name}>
<article class="article-page">
  <header class="article-heading">
    <a class="breadcrumb" href="/blog/">← Blog</a>
    <h1>{post.title}</h1>
    <div class="article-meta"><span>{site.author}</span><time datetime={post.createdDate}>{post.createdDate}</time>{site.comments.enabled && <a href="#comments-title">Discuss ↓</a>}</div>
    <TagLinks tags={post.tags} />
  </header>
  <div class="reading-layout">
    <div class="reading-main">
      <div class="post-content" set:html={body} />
      {(newer || older) && (
        <nav class="article-end" aria-label="Article navigation">
          {newer && <a class="article-step" rel="prev" href={newer.path}><span class="article-step-label"><span aria-hidden="true">← </span>Previous</span><span class="article-step-title">{newer.title}</span><time datetime={newer.createdDate}>{newer.createdDate}</time></a>}
          {older && <a class="article-step" rel="next" href={older.path}><span class="article-step-label">Next<span aria-hidden="true"> →</span></span><span class="article-step-title">{older.title}</span><time datetime={older.createdDate}>{older.createdDate}</time></a>}
        </nav>
      )}
      {site.comments.enabled && <Comments issueNumber={post.issueNumber} />}
    </div>
    <aside class="reading-margin" hidden>
      <details class="toc"><summary>On this page</summary><nav data-toc aria-label="On this page"></nav></details>
    </aside>
  </div>
</article>
</Base>
