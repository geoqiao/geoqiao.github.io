---
import Base from "../layouts/Base.astro";
import type { Archive } from "../lib/site";
import EntryList from "./EntryList.astro";

interface Props {
  archive: Archive;
}

const { archive } = Astro.props;
---
<Base title={archive.number === 1 ? "Blog" : `Blog · ${archive.number}`} path={archive.path} section="/blog/">
<div class="page-heading blog-heading"><p class="eyebrow">Notes in long form</p><h1>Blog<span class="heading-dot" aria-hidden="true">.</span></h1><div class="page-caption"><p>A collection, in chronological order.</p><a href="/tags/">Explore by topic ↗</a></div></div>
<EntryList posts={archive.posts} descriptions />
<nav class="pagination" aria-label="Blog pagination">
  {archive.prev ? <a rel="prev" href={archive.prev}>← Newer</a> : <span></span>}
  <span>{archive.number} / {archive.total}</span>
  {archive.next ? <a rel="next" href={archive.next}>Older →</a> : <span></span>}
</nav>
</Base>
