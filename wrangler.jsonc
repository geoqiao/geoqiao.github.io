{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "geoqiao-me",
  "account_id": "4c7b6a86dbcbd91469298d396009cccf",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    // Every address ends in a slash; an unknown address answers 404 with dist/404.html.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
